{
  "name": "anime-calendar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack && node scripts/package-standalone.mjs",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && node scripts/test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-db.mjs",
    "data:backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "data:restore": "node --env-file-if-exists=.env scripts/restore.mjs",
    "data:import-d1": "node --env-file-if-exists=.env scripts/import-d1.mjs",
    "generate:anilist-pilot": "node scripts/generate-anilist-pilot.mjs",
    "generate:syoboi-history": "node scripts/generate-syoboi-history.mjs",
    "generate:yuc-history-pilot": "node scripts/generate-yuc-history-pilot.mjs",
    "convert:covers-webp": "node scripts/convert-covers-to-webp.mjs",
    "generate:cover-sprites": "node scripts/generate-cover-sprites.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/better-sqlite3": "9.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "sharp": "0.35.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
